# ========== 生成模型（用于生成测试用例 & 模拟用户） ==========
# OpenAI 兼容接口，填写你的 API base url（结尾不要带 /chat/completions）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.7

# ========== 评估模型（用于 LLM-as-Judge 打分） ==========
# 推荐用更强的模型 + 低温度，留空则复用上面的生成模型
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
JUDGE_TEMPERATURE=0.2

# ========== Judge Ensemble 配置（G-Eval + 多次投票） ==========
# 评审次数（>=1，推荐奇数如 3/5 方便投票）
JUDGE_ENSEMBLE_N=3
# Temperature 抖动幅度（让多次调用产生差异）
JUDGE_TEMPERATURE_VAR=0.2
# 是否使用 G-Eval CoT 提示词（先推理再打分，更稳定）
JUDGE_USE_GEVAL=true

# ========== 评判阈值配置（新增） ==========
# 通过阈值（1.0-5.0），综合评分 >= 此值才判定通过
# 建议值：严格场景 4.0 / 标准场景 3.5 / 宽松场景 3.0
JUDGE_PASS_THRESHOLD=3.5
# 严格模式：true=规则层和LLM层都必须通过；false=只要LLM层通过即可
JUDGE_STRICT_MODE=true

# ========== 服务端口 ==========
PORT=8000

# ========== 并发与数据 ==========
# 单次 run 允许的最大并发用例数（前端 input 上限同步为此值）。
# 测试用例执行是 I/O 密集型（等 LLM 响应），8-10 通常瓶颈在对端 rate-limit；
# 想拉得更高需评估 judge 服务限流。
MAX_CONCURRENCY=10
DATA_DIR=./data

# ========== 网络 / 安全（默认值即生产推荐） ==========
# SSL 验证：默认开启（=1）。如在 Windows 遇到证书吊销检查失败（CRYPT_E_REVOCATION_OFFLINE）
# 可临时设 0 关掉。生产环境务必保持 1。
LLM_SSL_VERIFY=1
# 是否使用系统/环境代理：默认走（=1）。如本机代理干扰可设 0 绕开。
LLM_TRUST_ENV=1
# 服务监听地址：默认仅本机 127.0.0.1。需要 LAN 访问时再显式改 0.0.0.0，
# 并自行确认安全风险（鉴权层尚未启用前不建议公网暴露）。
HOST=127.0.0.1

# ========== 单密码鉴权（可选） ==========
# 留空 = 关闭鉴权（所有路由开放，仅适合 127.0.0.1 本地开发）。
# 配置后启用：浏览器首次访问会弹登录蒙层；session 7 天有效，重启进程后失效。
# 单 IP 连续 5 次输错会被锁 5 分钟。
ATF_PASSWORD=

# ========== 新建智能体弹窗默认值（可选） ==========
# 设置后，新建智能体弹窗的 api_key 字段会预填为此值（仅新建生效，编辑不覆盖）。
# 留空或不配置则前端字段为空。仅用于本地开发的便捷预填，请勿提交真实生产 key。
AGENT_DEFAULT_API_KEY=
